# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cartograph?schema=public"

# JWT signing secret for auth tokens
JWT_SECRET="dev-secret-change-in-production"

# HMAC secret used to derive store-scoped connector ingest keys
CONNECTOR_INGEST_SECRET="dev-ingest-secret-change-in-production"

# Optional runtime settings
PORT=3001
CORS_ORIGINS="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3001"

# Optional seed tuning
SEED_TOTAL_EVENTS=100000
SEED_BATCH_SIZE=500
